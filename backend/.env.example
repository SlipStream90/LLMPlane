# Backend / workers configuration.
# Copy to `.env` and fill in real values. NEVER commit a filled-in copy.
# Secrets below are placeholders, not usable values (Article XII).

# ---- datastores -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://llmplane:CHANGE_ME@postgres:5432/llmplane
REDIS_URL=redis://redis:6379/0

# ---- secrets --------------------------------------------------------------
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate multiple keys to rotate: the first encrypts, all decrypt.
FERNET_SECRET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# One-time token for POST /api/v1/auth/bootstrap-key (alpha has no login flow).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOTSTRAP_ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Must match the gateway container's LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=REPLACE_WITH_RANDOM_TOKEN

# ---- gateway (LiteLLM Proxy sibling container, ADR-001) -------------------
GATEWAY_BASE_URL=http://gateway:4000
LITELLM_CONFIG_PATH=/config/config.yaml
# Verified against docs.litellm.ai/docs/proxy/configs on 2026-08-01 for the
# pinned 1.94.x stable line. Change here, not in code, if a future tag renames it.
GATEWAY_CONFIG_UPDATE_PATH=/config/update

# ---- observability --------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=llmplane-backend
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- app ------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
BENCHMARK_UPLOAD_DIR=/data/benchmark_uploads

# ---- retention (data-models.md 3) ----------------------------------------
REQUEST_RETENTION_DAYS=90
GPU_SAMPLE_RETENTION_HOURS=72

# ---- deployment image tags ------------------------------------------------
# Deliberately not pinned in code: vLLM 0.26.0 was reported yanked days after
# release (methodology_brief.md 5). Verify the current tag before deploying.
LLMPLANE_OLLAMA_IMAGE_TAG=latest
LLMPLANE_VLLM_IMAGE_TAG=latest
