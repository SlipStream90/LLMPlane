# Backend / workers configuration.
# Copy to `.env` and fill in real values. NEVER commit a filled-in copy.
# Secrets below are placeholders, not usable values (Article XII).

# ---- datastores -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://llmplane:CHANGE_ME@postgres:5432/llmplane
REDIS_URL=redis://redis:6379/0

# ---- secrets --------------------------------------------------------------
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate multiple keys to rotate: the first encrypts, all decrypt.
FERNET_SECRET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# One-time token for POST /api/v1/auth/bootstrap-key (alpha has no login flow).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOTSTRAP_ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# ---- OpenRouter (replaces LiteLLM gateway) --------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- gateway (disabled — OpenRouter handles routing) ----------------------
GATEWAY_BASE_URL=http://localhost:4000
LITELLM_CONFIG_PATH=/config/config.yaml
GATEWAY_CONFIG_UPDATE_PATH=/config/update
ENABLE_STREAM_CONSUMER=false

# ---- observability --------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=llmplane-backend
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- app ------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Optional: write structured JSON logs here for the Log Explorer (GET /logs).
# LOG_FILE=/var/log/llmplane/backend.jsonl
CORS_ORIGINS=http://localhost:3000
BENCHMARK_UPLOAD_DIR=/data/benchmark_uploads

# ---- OAuth (GitHub + Google) ----------------------------------------------
# Leave empty to disable OAuth login. Create OAuth apps at:
#   GitHub: https://github.com/settings/developers → New OAuth App
#   Google: https://console.cloud.google.com/apis/credentials → Create OAuth client
# Callback URLs for your OAuth apps:
#   GitHub: http://localhost:8000/api/v1/auth/oauth/github/callback
#   Google: http://localhost:8000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:8000

# ---- retention (data-models.md 3) ----------------------------------------
REQUEST_RETENTION_DAYS=90
GPU_SAMPLE_RETENTION_HOURS=72

# ---- deployment image tags ------------------------------------------------
# Deliberately not pinned in code: vLLM 0.26.0 was reported yanked days after
# release (methodology_brief.md 5). Verify the current tag before deploying.
LLMPLANE_OLLAMA_IMAGE_TAG=latest
LLMPLANE_VLLM_IMAGE_TAG=latest
