# ──────────────────────────────────────────────────────────────
# LLM Control Plane — Docker Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values before running:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_postgres_password

# ── Auth & Secrets ───────────────────────────────────────────
FERNET_SECRET_KEY=changeme_fernet_key_generate_with_fernet_generate_key
BOOTSTRAP_ADMIN_TOKEN=changeme_bootstrap_admin_token

# ── OpenRouter (replaces LiteLLM gateway) ────────────────────
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Langfuse Cloud (tracing) ─────────────────────────────────
# Get these from https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_SECRET_KEY=sk-lf-changeme
# Base64 encoded PUBLIC_KEY:SECRET_KEY for OTLP Authorization header
LANGFUSE_AUTH_HEADER=changeme_base64_encoded

# ── Observability ────────────────────────────────────────────
GRAFANA_PASSWORD=changeme_grafana_password

# ── GPU (optional) ───────────────────────────────────────────
# NVIDIA_VISIBLE_DEVICES=all

# ── Database Backups (Cloudflare R2) ──────────────────────────
# R2 is S3-compatible with zero egress fees. Backups run every 6h via Celery Beat.
# Get credentials from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# S3_BUCKET=llmplane-backups
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_REGION=auto
# S3_PREFIX=llmplane/backups

# ── OAuth (GitHub + Google) ───────────────────────────────────
# Leave empty to disable OAuth. See backend/.env.example for callback URLs.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE_URL=http://localhost:8000
