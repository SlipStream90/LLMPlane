# Frontend environment variables for Vercel deployment.
# Set these in Vercel Dashboard → Settings → Environment Variables.
#
# These values come from your Railway backend deployment.
# Get the Railway URL from: Railway Dashboard → your service → Settings → Networking → Public Network

# ── Required ──────────────────────────────────────────────────
# Format: https://<your-railway-app-name>.up.railway.app
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# ── Optional ──────────────────────────────────────────────────
# Grafana Cloud: https://grafana.com → Your Stack URL
NEXT_PUBLIC_GRAFANA_URL=

# Langfuse Cloud: https://cloud.langfuse.com
NEXT_PUBLIC_LANGFUSE_URL=https://cloud.langfuse.com
